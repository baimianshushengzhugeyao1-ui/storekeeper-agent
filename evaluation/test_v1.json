    },
    {
      "id": "address_change-2",
      "text": "订单 #4052 的新城市是 Shanghai，其他地址信息之后补。",
      "expected_intent": "address_change",
      "expected_reference": "#4052",
      "expected_address": {
        "city": "Shanghai"
      }
    },
    {
      "id": "address_change-3",
      "text": "For #4053, set the new street address to 12 Example Street. I have not provided any other address fields.",
      "expected_intent": "address_change",
      "expected_reference": "#4053",
      "expected_address": {
        "address1": "12 Example Street"
      }
    },
    {
      "id": "address_change-4",
      "text": "Change the ZIP code on #4054 to 250000. All other new address fields are unspecified.",
      "expected_intent": "address_change",
      "expected_reference": "#4054",
      "expected_address": {
        "zip": "250000"
      }
    },
    {
      "id": "address_change-5",
      "text": "请修改我的收货地址，我还没提供订单编号或新地址。",
