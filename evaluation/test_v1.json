{
  "name": "storekeeper-frozen-test-v1",
  "created_date": "2026-10-30",
  "scope": "40 newly authored synthetic cases; separate from the old 24-case development set. Fixed before this run, not an external blind benchmark.",
  "cases": [
    {
      "id": "cancel_order-1",
      "text": "我不需要这笔订单了，请取消 #2048。",
      "expected_intent": "cancel_order",
      "expected_reference": "#2048"
    },
    {
      "id": "cancel_order-2",
      "text": "Could you stop order #2049 before it ships? Please cancel it.",
      "expected_intent": "cancel_order",
      "expected_reference": "#2049"
    },
    {
      "id": "cancel_order-3",
      "text": "下单买错了，请撤销 #2050。",
      "expected_intent": "cancel_order",
      "expected_reference": "#2050"
    },
    {
      "id": "cancel_order-4",
      "text": "I want to cancel my purchase; I cannot find its number.",
      "expected_intent": "cancel_order",
      "expected_reference": null
    },
    {
      "id": "cancel_order-5",
      "text": "麻烦把订单 #0007 作废，这次不需要修改收货地址。",
      "expected_intent": "cancel_order",
      "expected_reference": "#0007"
    },
    {
      "id": "cancel_order-6",
