      "expected_reference": "#3055"
    },
    {
      "id": "refund_request-7",
      "text": "我要申请退款，单号待会补。",
      "expected_intent": "refund_request",
      "expected_reference": null
    },
    {
      "id": "refund_request-8",
      "text": "The item from #3056 arrived damaged. I request my money back.",
      "expected_intent": "refund_request",
      "expected_reference": "#3056"
    },
    {
      "id": "address_change-1",
      "text": "Change the delivery address on #4051. I'll provide the new address later.",
      "expected_intent": "address_change",
      "expected_reference": "#4051",
